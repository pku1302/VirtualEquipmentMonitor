<Window x:Class="VirtualEquipmentMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Equipment Monitor"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ValueTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="가상 장비 모니터링"
                           FontSize="26"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding ConnectionStatus}"
                           Margin="0,6,0,0"
                           Foreground="#52606D"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="연결"
                        Command="{Binding ConnectCommand}"
                        Width="90"
                        Height="36"
                        Margin="0,0,8,0"/>

                <Button Content="연결 해제"
                        Command="{Binding DisconnectCommand}"
                        Width="100"
                        Height="36"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="장비 ID:"
                           FontWeight="SemiBold"/>
                
                <TextBlock Text="{Binding DeviceId}"
                           Margin="8,0,24,0"/>
                
                <TextBlock Text="상태:"
                           FontWeight="SemiBold"/>
                
                <TextBlock Text="{Binding OperatingState}"
                           Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="온도 (°C)"
                               HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="{Binding Temperature,
                               StringFormat={}{0:F2}}"
                        Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="회전 속도 (RPM)"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding Rpm}"
                               Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="진동 (mm/s)"
                               HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="{Binding Vibration,
                               StringFormat={}{0:F2}}"
                        Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="6,14,6,0">
            <TextBlock
                Text="{Binding LastUpdatedAt,
                       StringFormat='마지막 수신: {0:yyyy-MM-dd HH:mm:ss zzz}'}"
                Foreground="#52606D"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#C62828"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
